{
  "name": "laplace-rinnegan",
  "version": "0.1.0",
  "description": "Detect 独轮车 (looped duplicate danmaku) spammers in Bilibili Live rooms, live or from LAPLACE Chat archives",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "bin": {
    "rinnegan": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "live": "bun run src/cli.ts live",
    "offline": "bun run src/cli.ts offline",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/rinnegan",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@laplace.live/event-bridge-sdk": "^1.2.2",
    "@laplace.live/event-types": "^2.0.21",
    "@laplace.live/login-sync": "^1.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
