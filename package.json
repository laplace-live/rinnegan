{
  "name": "@laplace.live/rinnegan",
  "version": "0.1.0",
  "description": "Detect 独轮车 (looped duplicate danmaku) spammers in Bilibili Live rooms, live or from LAPLACE Chat archives",
  "keywords": [
    "bilibili",
    "bilibili-live",
    "danmaku",
    "moderation",
    "spam"
  ],
  "homepage": "https://github.com/laplace-live/rinnegan#readme",
  "bugs": "https://github.com/laplace-live/rinnegan/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laplace-live/rinnegan.git"
  },
  "license": "AGPL-3.0-only",
  "author": "LAPLACE Live! <s@laplace.live>",
  "type": "module",
  "bin": {
    "rinnegan": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "rinnegan.config.example.json"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "live": "bun run src/cli.ts live",
    "offline": "bun run src/cli.ts offline",
    "build": "bun build src/cli.ts --target bun --external uqr --outfile dist/cli.js",
    "compile": "bun build src/cli.ts --compile --minify --outfile dist/rinnegan",
    "prepack": "bun run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@laplace.live/bilibili-qr": "^0.1.0",
    "@laplace.live/event-bridge-sdk": "^1.2.2",
    "@laplace.live/event-types": "^2.0.21",
    "@laplace.live/login-sync": "^1.2.1",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
