{
  "name": "laplace-rinnegan-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run apps/rinnegan/src/cli.ts",
    "live": "bun run apps/rinnegan/src/cli.ts live",
    "offline": "bun run apps/rinnegan/src/cli.ts offline",
    "build": "bun run --filter '*' build",
    "compile": "bun run --filter @laplace.live/rinnegan compile",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "version": "changeset version && bun install --lockfile-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3"
  }
}
